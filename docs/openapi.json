    "/planner/stops/{stopId}/times": {
      "get": {
        "operationId": "getStopArrivals",
        "summary": "Upcoming arrivals, grouped by route and pattern",
        "security": [],
        "responses": {
          "200": {
            "description": "JSON response; arrays may be empty.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schema.json#/$defs/ArrivalGroup"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Upstream/network failure. Do not assume a JSON error body; check HTTP status and back off."
          }
        },
        "parameters": [
          {
            "name": "stopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "description": "Window of upcoming arrivals, not a complete weekly timetable. UTC timestamps. Estimated arrival = scheduledArrival + arrivalDelay seconds only when realtime=true."
      }
    },
