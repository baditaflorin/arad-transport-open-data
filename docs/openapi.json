{
  "openapi": "3.1.0",
  "info": {
    "title": "Arad public transport integration kit",
    "version": "1.0.0",
    "description": "Observed public Telelink API plus dated GitHub Pages exports. Independent community project. No API key. CORS from GitHub Pages verified 2026-11-07. No upstream reuse license identified; MIT covers project code only."
  },
  "servers": [
    {
      "url": "https://www.telelink.city/api/v1/e39aa927-11c1-435f-92b9-57804f7bc1b4/transport",
      "description": "Public upstream live source, not a project relay"
    }
  ],
  "security": [],
  "paths": {
    "/planner/vehicles": {
      "get": {
        "operationId": "getLiveVehicles",
        "summary": "All publicly available live vehicle positions",
        "security": [],
        "responses": {
          "200": {
            "description": "JSON response; arrays may be empty.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schema.json#/$defs/Vehicle"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Upstream/network failure. Do not assume a JSON error body; check HTTP status and back off."
          }
        },
        "description": "One request returns all vehicles. No credentials. Poll every 30s in the demo, pause hidden tabs, mark lastUpdated older than 120s stale. These are project conventions, not published operator limits."
      }
    },
    "/planner/vehicles/route/{routeId}": {
      "get": {
        "operationId": "getRouteVehicles",
        "summary": "Vehicles for an internal route ID",
        "security": [],
        "responses": {
          "200": {
            "description": "JSON response; arrays may be empty.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "./schema.json#/$defs/RouteVehicle"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Upstream/network failure. Do not assume a JSON error body; check HTTP status and back off."
          }
        },
        "parameters": [
          {
            "name": "routeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/planner/routes": {
      "get": {
        "operationId": "getSourceRoutes",
